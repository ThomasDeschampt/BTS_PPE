@model IEnumerable<Model.medecin>

@{
    ViewBag.Title = "Index";
}

<h2>Liste des médecins :</h2>

@using (Html.BeginForm("Index", "medecins", FormMethod.Get))
{
    <input type="text" name="nom" placeholder="Nom du médecin">
    <button type="submit">Rechercher</button>
}


<p>
    @Html.ActionLink("Ajouter", "Create")
</p>
<table class="table">
    <tr>
        <th>
            @Html.DisplayName("Département")
        </th>
        <th>
            @Html.DisplayName("Spécialité")
        </th>
        <th>
            @Html.DisplayName("Nom")
        </th>
        <th>
            @Html.DisplayName("Prénom")
        </th>
        <th>
            @Html.DisplayName("Adresse")
        </th>
        <th>
            @Html.DisplayName("Téléphone")
        </th>
        <th></th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.departement.nom_dep)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.specialite.lib_spe)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.nom_med)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.pre_med)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.adr_med)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.tel_med)
            </td>
            <td>
                @Html.ActionLink("Modifier", "Edit", new { id = item.id_med }) |
                @Html.ActionLink("Détails", "Details", new { id = item.id_med }) |
                @Html.ActionLink("Supprimer", "Delete", new { id = item.id_med })
            </td>
        </tr>
    }

</table>

<style>
    h2 {
        font-size: xx-large;
        text-decoration: underline;
        font-weight: bold;
    }

    form {
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    input[type="text"] {
        padding: 8px;
        border: 1px solid #ccc;
        border-radius: 4px;
        margin: 8px;
        width: 300px;
        max-width: 100%;
    }

    button[type="submit"] {
        background-color: darkblue;
        color: white;
        border: none;
        border-radius: 4px;
        padding: 8px 16px;
        cursor: pointer;
        transition: background-color 0.3s ease;
    }

    button[type="submit"]:hover {
            background-color: #3e8e41;
    }

    .table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 16px;
    }

    th, td {
        text-align: center;
        padding: 8px;
        border: 1px solid #ddd;
    }

    th {
        background-color: #f2f2f2;
    }

    tr:hover {
        background-color: #f5f5f5;
    }

    .action-link {
        display: inline-block;
        background-color: #4CAF50;
        color: white;
        border: none;
        border-radius: 4px;
        padding: 8px 16px;
        margin-bottom: 16px;
        cursor: pointer;
        transition: background-color 0.3s ease;
    }

    .action-link:hover {
        background-color: #3e8e41;
    }
</style>