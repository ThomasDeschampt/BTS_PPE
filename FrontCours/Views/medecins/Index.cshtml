@model IEnumerable<Model.medecin>

@{
    ViewBag.Title = "Index";
}

<h2>Index</h2>

<p>
    @Html.ActionLink("Create New", "Create")
</p>
<table class="table">
    <tr>
        <th>
            @Html.DisplayName("Département")
        </th>
        <th>
            @Html.DisplayName("Spécialité")
        </th>
        <th>
            @Html.DisplayName("Nom")
        </th>
        <th>
            @Html.DisplayName("Prénom")
        </th>
        <th>
            @Html.DisplayName("Adresse")
        </th>
        <th>
            @Html.DisplayName("Téléphone")
        </th>
        <th></th>
    </tr>

@foreach (var item in Model) {
    <tr>
        <td>
            @Html.DisplayFor(modelItem => item.departement.nom_dep)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.specialite.lib_spe)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.nom_med)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.pre_med)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.adr_med)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.tel_med)
        </td>
        <td>
            @Html.ActionLink("Edit", "Edit", new { id=item.id_med }) |
            @Html.ActionLink("Details", "Details", new { id=item.id_med }) |
            @Html.ActionLink("Delete", "Delete", new { id=item.id_med })
        </td>
    </tr>
}

</table>
