@model Model.medecin

@{
    ViewBag.Title = "Details";
}

<h2>Détails</h2>

<div>
    <hr />
    <dl>
        <dt>
            @Html.DisplayName("Département :")
        </dt>

        <dd>
            @Html.DisplayFor(model => model.departement.nom_dep)
        </dd>

        <dt>
            @Html.DisplayName("Spécialité :")
        </dt>

        <dd>
            @Html.DisplayFor(model => model.specialite.lib_spe)
        </dd>

        <dt>
            @Html.DisplayName("Nom :")
        </dt>

        <dd>
            @Html.DisplayFor(model => model.nom_med)
        </dd>

        <dt>
            @Html.DisplayName("Prénom :")
        </dt>

        <dd>
            @Html.DisplayFor(model => model.pre_med)
        </dd>

        <dt>
            @Html.DisplayName("Adresse")
        </dt>

        <dd>
            @Html.DisplayFor(model => model.adr_med)
        </dd>

        <dt>
            @Html.DisplayName("Téléphone :")
        </dt>

        <dd>
            @Html.DisplayFor(model => model.tel_med)
        </dd>

    </dl>
</div>
<p>
    @Html.ActionLink("Modifier", "Edit", new { id = Model.id_med }) |
    @Html.ActionLink("Retour", "Index")
</p>

<style>
    h2 {
        font-size: xx-large;
        text-decoration: underline;
        font-weight: bold;
    }

    .table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 16px;
    }

    th, td {
        text-align: center;
        padding: 8px;
        border: 1px solid #ddd;
    }

    th {
        background-color: #f2f2f2;
    }

    tr:hover {
        background-color: #f5f5f5;
    }

    .action-link {
        display: inline-block;
        background-color: #4CAF50;
        color: white;
        border: none;
        border-radius: 4px;
        padding: 8px 16px;
        margin-bottom: 16px;
        cursor: pointer;
        transition: background-color 0.3s ease;
    }

        .action-link:hover {
            background-color: #3e8e41;
        }

    #phrase {
        text-decoration: underline;
        font-size: x-large;
    }

    dt {
        text-align: left;
        align-content: start;
        font-weight: bold;
        font-size: large;
        text-decoration: underline;
    }
</style>