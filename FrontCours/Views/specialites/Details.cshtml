@model Model.specialite

@{
    ViewBag.Title = "Details";
}

<h2>Détails</h2>

<div>

    <hr />
    <dl>
        <dt>
            @Html.DisplayName("Libellé :")
        </dt>

        <dd>
            @Html.DisplayFor(model => model.lib_spe)
        </dd>

    </dl>
</div>

@if (Model.medecins.Count != 0)
{
<p id="phrase">Liste des médecins de la spécialité :</p>
<table class="table">
    <tr>
        <th>
            @Html.DisplayName("Nom")
        </th>
        <th>
            @Html.DisplayName("Prénom")
        </th>
        <th>
            @Html.DisplayName("Adresse")
        </th>
        <th>
            @Html.DisplayName("Téléphone")
        </th>
        <th>
            @Html.DisplayName("Départements")
        </th>
    </tr>

    @foreach (var item in Model.medecins)
    {
    <tr>
        <td>
            @Html.DisplayFor(modelItem => item.nom_med)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.pre_med)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.adr_med)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.tel_med)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.departement.nom_dep)
        </td>
    </tr>
    }
</table>
}

<p>
    @Html.ActionLink("Modifier", "Edit", new { id = Model.id_spe }) |
    @Html.ActionLink("Retour", "Index")
</p>

<style>
    h2 {
        font-size: xx-large;
        text-decoration: underline;
        font-weight: bold;
    }

    .table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 16px;
    }

    th, td {
        text-align: center;
        padding: 8px;
        border: 1px solid #ddd;
    }

    th {
        background-color: #f2f2f2;
    }

    tr:hover {
        background-color: #f5f5f5;
    }

    .action-link {
        display: inline-block;
        background-color: #4CAF50;
        color: white;
        border: none;
        border-radius: 4px;
        padding: 8px 16px;
        margin-bottom: 16px;
        cursor: pointer;
        transition: background-color 0.3s ease;
    }

        .action-link:hover {
            background-color: #3e8e41;
        }

    #phrase {
        text-decoration: underline;
        font-size: x-large;
    }

    dt {
        text-align: left;
        align-content: start;
        font-weight: bold;
        font-size: large;
        text-decoration: underline;
    }
</style>